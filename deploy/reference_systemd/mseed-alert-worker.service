[Unit]
Description=miniSEED Alert Worker
After=network.target mseed-web-portal.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/mseed-web-portal
Environment=MSEED_WEB_CONFIG=/etc/mseed-web-portal/portal.ini
ExecStart=/opt/miniforge3/envs/mseed-web/bin/python /opt/mseed-web-portal/tools/check_alerts.py
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=30%
MemoryMax=300M
